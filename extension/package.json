{
  "name": "loupe-merch-extension",
  "version": "1.4.0",
  "private": true,
  "description": "Loupe: research, sales analytics and listing tools for Amazon Merch on Demand (Chrome extension, Manifest V3)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/build.mjs && node e2e/run.mjs",
    "zip": "node scripts/build.mjs && node scripts/zip.mjs"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "playwright-core": "1.56.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
